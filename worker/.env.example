# Worker env (box only — copy to worker/.env, never commit)
SUPABASE_URL=https://isdmoifsletqepymqqwi.supabase.co
SUPABASE_SECRET_KEY=

# Logged-in session captured by login-capture.ts
YT_STATE_FILE=worker/yt-state.json

# Posting policy
POST_MIN_RESTAURANTS=2
POST_MAX_PER_DAY=10
POST_MAX_PER_HOUR=2
POST_START_HOUR=9
POST_END_HOUR=22
POST_MIN_GAP_MIN=20
POST_MAX_GAP_MIN=90
TICK_MIN=5

# false → run under xvfb-run (recommended, less detectable). true → pure headless.
HEADLESS=false
