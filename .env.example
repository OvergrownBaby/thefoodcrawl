# Mock data toggle — true = use seeded mock data, false = call live APIs
NEXT_PUBLIC_USE_MOCK_DATA=false

# Gemini (https://aistudio.google.com/app/apikey) — for video extraction
GEMINI_API_KEY=

# Anthropic (https://console.anthropic.com) — for text extraction
ANTHROPIC_API_KEY=

# Google Places API (https://console.cloud.google.com) — enable Places API (New)
# and Geocoding API. 10K free calls/month, requires billing card.
GOOGLE_PLACES_API_KEY=

# Supabase (https://supabase.com/dashboard) — create a new project,
# then copy from Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_ID=

# Public origin (used for WebSub callback + comment watermark links)
NEXT_PUBLIC_SITE_URL=https://thefoodcrawl.com

# Creator-upload tracker (Stages 1–3)
# Shared secret the WebSub hub echoes back on (un)subscribe verification.
WEBSUB_VERIFY_TOKEN=
# Bearer secret guarding /api/tracker/* internal routes. Vercel Cron sends it
# automatically when set in project env.
CRON_SECRET=
# YouTube Data API key — only needed later for Stage 5 (comment survival check).
YOUTUBE_API_KEY=
